{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rimeflow.dev/schemas/android-litert-runner-report.schema.json",
  "title": "Rimeflow Android LiteRT Runner Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "selectionCode", "bundleId", "bundleManifestSha256", "target", "runnerSha256", "modelManifestSha256", "artifactSha256", "runtimeVersion", "rustBindingVersion", "configuredProvider", "accelerator", "device", "outputs", "performance", "loadedLibraries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "state": { "enum": ["runtime-verified", "failed"] },
    "selectionCode": { "type": "string", "minLength": 1 },
    "failureStage": { "type": ["string", "null"] },
    "failureMessage": { "type": ["string", "null"] },
    "bundleId": { "type": "string", "minLength": 1 },
    "bundleManifestSha256": { "$ref": "#/$defs/sha256" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": { "os": { "const": "android" }, "arch": { "enum": ["arm64", "x86_64"] } }
    },
    "runnerSha256": { "$ref": "#/$defs/sha256" },
    "modelManifestSha256": { "$ref": "#/$defs/sha256" },
    "artifactSha256": { "$ref": "#/$defs/sha256" },
    "runtimeVersion": { "const": "2.1.6" },
    "rustBindingVersion": { "const": "0.1.3" },
    "configuredProvider": { "const": "LiteRT CompiledModel" },
    "accelerator": { "const": "CPU" },
    "resolved": { "type": ["object", "null"] },
    "ioDiagnostics": { "type": ["object", "null"] },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serial", "manufacturer", "model", "fingerprint", "apiLevel", "abi"],
      "properties": {
        "serial": { "type": ["string", "null"] },
        "manufacturer": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "fingerprint": { "type": ["string", "null"] },
        "apiLevel": { "type": ["string", "null"] },
        "abi": { "type": ["string", "null"] }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixtureId", "fixtureKind", "run", "path", "bytes", "sha256", "shape", "dtype", "inferenceMs"],
        "properties": {
          "fixtureId": { "type": "string", "minLength": 1 },
          "fixtureKind": { "enum": ["golden", "fault-never-promote"] },
          "run": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "pattern": "^outputs/" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "shape": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "dtype": { "enum": ["f32", "f16", "i8", "u8", "i32", "i64", "bool"] },
          "inferenceMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initializationMs", "initializationDeadlineMs", "coldInferenceMs", "warmupRuns", "warmInferenceMs", "peakProcessRssBytes"],
      "properties": {
        "initializationMs": { "type": "integer", "minimum": 0 },
        "initializationDeadlineMs": { "const": 30000 },
        "coldInferenceMs": { "type": ["number", "null"], "minimum": 0 },
        "warmupRuns": { "const": 5 },
        "warmInferenceMs": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "peakProcessRssBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "loadedLibraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
